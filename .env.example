# HealthFlow Engine — Environment Variables
# Copy to .env and fill in your values
# All variables use the HF_ prefix

# App
HF_DEBUG=false
HF_LOG_LEVEL=INFO

# Database (PostgreSQL + TimescaleDB)
HF_DATABASE_URL=postgresql+asyncpg://healthflow:healthflow@localhost:5432/healthflow
HF_DATABASE_POOL_SIZE=20

# NATS JetStream
HF_NATS_URL=nats://localhost:4222
HF_NATS_STREAM_NAME=HEALTHFLOW

# Redis
HF_REDIS_URL=redis://localhost:6379

# AWS Bedrock (for AI agents)
HF_AWS_REGION=us-east-1
HF_AWS_ACCESS_KEY_ID=
HF_AWS_SECRET_ACCESS_KEY=
HF_BEDROCK_MODEL_SONNET=us.anthropic.claude-sonnet-4-6-20250514-v1:0
HF_BEDROCK_MODEL_OPUS=us.anthropic.claude-opus-4-6-20250514-v1:0

# MLLP
HF_MLLP_DEFAULT_PORT=2575
HF_MLLP_READ_TIMEOUT=30
HF_MLLP_ACK_MODE=immediate

# OpenTelemetry
HF_OTEL_ENDPOINT=http://localhost:4317
HF_OTEL_SERVICE_NAME=healthflow-engine
HF_OTEL_ENABLED=true
